# Copy this file to .env and fill it in. It configures the gitclaudehub site (and, if you run
# `gitclaudehub host` from this folder, gives the host its GITHUB_TOKEN).

# --- The site ---
PORT=3000
# The site listens on this computer only; tunnels and proxies reach it here.
# Set HOST=0.0.0.0 to open it to your network (or inside Docker).
# HOST=127.0.0.1

# If set, creating a room needs this code. Without it, anyone with the site's link can create rooms
# (each still needs its owner's own computer to do any work). At most MAX_ROOMS rooms.
# CREATE_ROOM_CODE=
# MAX_ROOMS=100

# Previews of each room's built site are served on PREVIEW_PORT (default PORT + 1).
# Behind a tunnel or proxy, set PREVIEW_URL to that port's public address. start-room.sh does this.
# PREVIEW_PORT=3001
# PREVIEW_URL=https://preview.example.com
# PUBLIC_URL=https://rooms.example.com      # the site's public address (start-room.sh sets it)

# DATA_DIR=./data                           # rooms, cached conversations, the cookie secret

# --- A host on this computer ---
# `gitclaudehub host` clones and pushes with git's own credentials. For a private repo over https
# without them, put a fine-grained GitHub token here (that repo only, "Contents: Read and write").
GITHUB_TOKEN=
# Claude turns use this computer's Claude Code login, or this key if it's set (then every turn is billed to it).
ANTHROPIC_API_KEY=

# --- Carrying over the old one-room setup (read once, on the site's first start) ---
# If GITHUB_REPO and ROOM_PASSWORD are set, they become a room on the site with a host on this
# computer. Its owner link is written to data/hub/owner-links.txt.
# GITHUB_REPO=your-name/your-project
# ROOM_PASSWORD=
# ROOM_NAME=
# PREVIEW_DIR=.
# MAX_BUDGET_USD=2
# CLAUDE_MODEL=claude-sonnet-5-5
# APPROVAL_MODE=ask-bash
